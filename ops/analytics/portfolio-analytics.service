[Unit]
Description=Generate the private Heard Sheep traffic dashboard
After=nginx.service

[Service]
Type=oneshot
User=root
Group=www-data
UMask=0027
ExecStart=/usr/bin/python3 /usr/local/lib/portfolio-analytics/generate_dashboard.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/portfolio-analytics
